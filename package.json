{
  "name": "radar-backend",
  "private": true,
  "type": "module",
  "description": "RADAR backend on Neon: Hono API as a Neon Function (Postgres, Auth, Realtime). The iOS app lives in RADAR/.",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "neon dev",
    "migrate": "node scripts/migrate.mjs",
    "verify": "NODE_USE_ENV_PROXY=1 node scripts/verify.mjs",
    "plan": "neon config plan",
    "deploy": "neon deploy --env .env.local"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.2.1",
    "hono": "^4.13.21",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
